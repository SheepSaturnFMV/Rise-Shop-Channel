{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sheepsaturnfmv.github.io/Rise-Shop-Channel/repo/schema/app.schema.json",
  "title": "Rise Shop Channel app metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "author",
    "version",
    "category",
    "description",
    "license",
    "download",
    "requires_original_files"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Stable lowercase app ID. Use letters, numbers, and hyphens only."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "enum": [
        "games",
        "emulators",
        "ports",
        "utilities",
        "media",
        "launchers",
        "other"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "website": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "download": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "type",
        "install_path"
      ],
      "properties": {
        "url": {
          "type": "string",
          "description": "Official HTTPS download URL for a ZIP package whenever possible."
        },
        "type": {
          "type": "string",
          "enum": [
            "zip"
          ]
        },
        "install_path": {
          "type": "string",
          "pattern": "^apps/[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "Expected Homebrew Channel folder inside the package or install destination."
        },
        "sha256": {
          "type": "string",
          "pattern": "^$|^[a-fA-F0-9]{64}$"
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "icon": {
          "type": "string"
        },
        "screenshots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "requires_original_files": {
      "type": "boolean"
    },
    "original_files_note": {
      "type": "string"
    },
    "curation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "candidate",
            "approved",
            "example"
          ]
        },
        "tested_on": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
